# Подключение к PostgreSQL (asyncpg). Локально: brew services start postgresql@15
FINIK_DATABASE_URL=postgresql+asyncpg://localhost:5432/finik
# Секрет подписи токенов. В проде заменить на длинную случайную строку.
FINIK_JWT_SECRET=change-me-in-production-please-use-32-bytes
# Срок жизни токена устройства в днях
FINIK_JWT_TTL_DAYS=180
# Показывать /docs и подробные ошибки
FINIK_DEBUG=true

# GigaChat. Ключ авторизации из Studio (Настройки API → Получить ключ), показывается один раз.
# Пустое значение выключает ИИ: сервер работает на заготовленных фразах.
FINIK_GIGACHAT_AUTH_KEY=
# Модель: GigaChat (Lite, самая дешёвая), GigaChat-Pro, GigaChat-Max
FINIK_GIGACHAT_MODEL=GigaChat
# Если ловите ошибку сертификата, поставьте false или установите корневой сертификат Минцифры
FINIK_GIGACHAT_VERIFY_SSL=true
